{
  "name": "@stanzaapi/peppol-validator",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for Peppol BIS Billing 3.0 & EN 16931 E-Invoice Engine",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "peppol",
    "en16931",
    "e-invoicing",
    "ubl-2-1",
    "factur-x",
    "zugferd",
    "bis-billing-3",
    "electronic-invoicing",
    "un-cefact-cii"
  ],
  "author": "Stanza",
  "license": "MIT",
  "homepage": "https://stanzaapi.com/tools/peppol-validator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stanzaapi/peppol-validator-typescript.git"
  }
}